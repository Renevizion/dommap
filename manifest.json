{
  "manifest_version": 3,
  "name": "DOM Explorer Blueprint",
  "version": "1.0.0",
  "description": "Hover inspector + immersive 3D X-Ray view of any page's DOM structure.",
  "icons": {
    "16":  "icons/icon.svg",
    "48":  "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_title": "DOM Explorer Blueprint",
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon.svg",
      "48":  "icons/icon.svg",
      "128": "icons/icon.svg"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"]
}
